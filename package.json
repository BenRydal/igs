{
  "name": "igs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "knip": "svelte-kit sync && knip",
    "loc": "node tools/loc.mjs",
    "format": "prettier --write .",
    "test": "svelte-kit sync && vitest run",
    "verify": "node tools/verify-igs/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/mdi": "^1.2.3",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-vercel": "^7.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/papaparse": "^5.5.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "knip": "^6.46.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.5",
    "svelte-eslint-parser": "^1.10.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.0.12",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@types/luxon": "^3.7.1",
    "daisyui": "^5.0.0",
    "driver.js": "^1.4.0",
    "luxon": "^3.7.2",
    "p5": "^2.4.0",
    "papaparse": "^5.5.3",
    "svelte-p5": "^1.3.0",
    "svelte-p5-components": "^2.3.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
